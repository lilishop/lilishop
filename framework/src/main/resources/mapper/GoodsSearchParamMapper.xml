<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.lili.modules.goods.mapper.GoodsSearchParamMapper">

    <!--
      @author Mike
      @date 2026-09-03
      参数筛选项聚合：
      - 内层先用与列表相同的 WHERE 得到候选 goods_id（IN 子查询）
      - 外层从倒排表聚出 (param_name, param_value)，MIN(param_sort) 供面板排序
      - excludeNames：已选参数名整维不返回（仅影响输出，不影响候选集）
      - NULL sort 排最后（IS NULL 首键）
    -->
    <select id="selectSelectorParams" resultType="cn.lili.modules.goods.entity.dto.GoodsSearchParamFacetRow">
        SELECT p.param_name, p.param_value, MIN(p.param_sort) AS sort
        FROM li_goods_search_param p
        WHERE p.goods_id IN (
                SELECT gs.goods_id FROM li_goods_sku gs
                INNER JOIN li_goods g ON gs.goods_id = g.id
                ${ew.customSqlSegment})
        <if test="excludeNames != null and excludeNames.size() > 0">
            AND p.param_name NOT IN
            <foreach collection="excludeNames" item="n" open="(" separator="," close=")">#{n}</foreach>
        </if>
        GROUP BY p.param_name, p.param_value
        ORDER BY MIN(p.param_sort) IS NULL, MIN(p.param_sort), p.param_value
    </select>
</mapper>
